<UserControl x:Class="MailHelper.App.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailHelper.ViewModels;assembly=MailHelper.ViewModels" xmlns:app="clr-namespace:MailHelper.App">
    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolToVis" /><app:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource AppText}"><Setter Property="FontSize" Value="13" /></Style>
    </UserControl.Resources>
    <Grid Margin="28,24" MaxWidth="1120">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button Content="⟳ 刷新" Style="{StaticResource GhostButton}" Padding="16,9" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="留一点从容给截止日" FontSize="11" Foreground="{DynamicResource BrushPrimary}" />
                <WrapPanel Margin="0,5,0,8" VerticalAlignment="Center">
                    <TextBlock Text="日程" FontSize="28" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource BrushPrimaryTint}" CornerRadius="6" Padding="10,5" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OpenCount, StringFormat={}{0} 项待完成}" AutomationProperties.AutomationId="schedule-summary" FontSize="12" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" />
                    </Border>
                </WrapPanel>
                <TextBlock Text="Canvas 作业截止日期自动汇集在这里。完成一项，就少一件挂心的事。" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,4,0"><ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScheduleGroupViewModel}">
                        <StackPanel Margin="0,0,0,22">
                            <DockPanel Margin="2,0,2,10">
                                <TextBlock Text="{Binding HeaderBadge}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" />
                                <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScheduleItemRowViewModel}">
                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="12" Padding="20,16" Margin="0,0,0,8" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Title}" Margin="0,0,16,10" />
                                            <Border Grid.Column="1" Background="{DynamicResource BrushPrimaryTint}" CornerRadius="6" Padding="9,5" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding RelativeText}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AppText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding CourseDisplay}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding DueText}" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" Margin="10,0,0,0" Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolVis}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Content="Canvas ↗" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,0,6,0" Click="OnOpenLink" Tag="{Binding Link}" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="完成" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="忽略" Style="{StaticResource GhostButton}" Padding="10,6" Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="恢复" Style="{StaticResource GhostButton}" Padding="12,6" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolVis}}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="32" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolVis}}">
                <Border Width="64" Height="64" Background="{DynamicResource BrushPrimaryTint}" CornerRadius="18" HorizontalAlignment="Center">
                    <Path Data="M 5,8 L 27,8 27,28 5,28 Z M 10,4 L 10,12 M 22,4 L 22,12 M 5,16 L 27,16 M 11,22 L 14,25 21,19" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource BrushPrimary}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="暂时没有待安排的事" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,10" />
                <TextBlock Text="同步邮箱后，识别到的 Canvas 作业截止日期会自动出现在这里。" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding LastSyncText}" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}" Margin="2,12,0,0" />
    </Grid>
</UserControl>
