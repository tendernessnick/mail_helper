<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MailHelper.App.Avalonia.SettingsPage">
  <!-- 设置页（FR-03/04/06、05 §3.4 五分组；SettingsViewModel 共享，行为与 WPF 一致） -->
  <Border Background="{DynamicResource BrushSurface}" CornerRadius="{StaticResource RadiusLarge}" Margin="12">
    <ScrollViewer>
      <StackPanel Margin="20" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">

        <!-- 账户 -->
        <TextBlock Text="账户" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding AccountEmail}" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding Channel}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
          <TextBlock Text="{Binding LastSync}" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" />
        </StackPanel>
        <Button Classes="navItem" Content="清除本地数据（退出并删除本机缓存）" Click="OnClearLocalData" />

        <Border Background="{DynamicResource BrushDivider}" Height="1" />

        <!-- 同步 -->
        <TextBlock Text="同步" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="同步间隔（分钟，1–60）" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSecondary}" />
          <NumericUpDown Minimum="1" Maximum="60" Increment="1" Width="120"
                         Value="{Binding IntervalMinutes, Mode=TwoWay}" />
        </StackPanel>
        <CheckBox Content="启动时立即同步" IsChecked="{Binding SyncOnStartup, Mode=TwoWay}" />

        <Border Background="{DynamicResource BrushDivider}" Height="1" />

        <!-- 通知 -->
        <TextBlock Text="通知" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <CheckBox Content="P0 紧急邮件逐封通知" IsChecked="{Binding NotifyP0, Mode=TwoWay}" />
        <CheckBox Content="P1 重要邮件汇总通知" IsChecked="{Binding NotifyP1, Mode=TwoWay}" />

        <Border Background="{DynamicResource BrushDivider}" Height="1" />

        <!-- 外观 -->
        <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="界面语言（重启生效）" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSecondary}" />
          <ComboBox x:Name="LanguageBox" Width="140" SelectionChanged="OnLanguageChanged">
            <ComboBoxItem Content="跟随系统" Tag="auto" />
            <ComboBoxItem Content="简体中文" Tag="zh-CN" />
            <ComboBoxItem Content="English" Tag="en" />
          </ComboBox>
        </StackPanel>

        <Border Background="{DynamicResource BrushDivider}" Height="1" />

        <!-- 自定义类别（S14-C/CHG-012：行为与 WPF 一致） -->
        <TextBlock Text="自定义类别" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <ItemsControl x:Name="CustomCategoriesList" MaxHeight="160">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,3">
                <TextBlock Text="{Binding Icon}" FontSize="14" />
                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                <Button Classes="navItem" Content="删除" FontSize="11" Tag="{Binding Id}" Click="OnDeleteCategory" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="NewCategoryName" Width="160" Watermark="类别名称" />
          <TextBox x:Name="NewCategoryIcon" Width="60" Watermark="图标" />
          <Button Classes="primaryAction" Content="添加类别" Click="OnAddCategory" />
        </StackPanel>

        <Border Background="{DynamicResource BrushDivider}" Height="1" />

        <!-- 高级 -->
        <TextBlock Text="高级" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <CheckBox x:Name="AutostartCheck" Content="开机自启动" Checked="OnAutostartChecked" Unchecked="OnAutostartUnchecked" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="正文缓存上限（MB）" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSecondary}" />
          <NumericUpDown Minimum="256" Maximum="8192" Increment="256" Width="140"
                         Value="{Binding BodyLimitMb, Mode=TwoWay}" />
        </StackPanel>

        <Border Background="{DynamicResource BrushDivider}" Height="1" />

        <!-- 关于/更新（S17；mac=引导下载 DMG，docs/10 §9） -->
        <TextBlock Text="关于与更新" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding AppVersion, StringFormat=当前版本 v{0}}" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSecondary}" />
          <Button Classes="primaryAction" Content="检查更新"
                  IsEnabled="{Binding CanCheckUpdate}"
                  Command="{Binding CheckUpdateCommand}" />
          <Button Classes="navItem" Content="重启并安装更新"
                  IsVisible="{Binding UpdateReady}"
                  Command="{Binding ApplyUpdateCommand}" />
          <TextBlock Text="{Binding UpdateStatus}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>
        <TextBlock Text="macOS 版更新为「下载 DMG 手动安装」；自动更新列后续（docs/10 §9）" FontSize="11"
                   Foreground="{DynamicResource BrushTextTertiary}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
