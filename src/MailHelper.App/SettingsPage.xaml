<UserControl x:Class="MailHelper.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MailHelper.App"
             xmlns:vm="clr-namespace:MailHelper.App.ViewModels">
    <UserControl.Resources>
        <app:CategoryToBrushConverter x:Key="CategoryBrush" />
        <app:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16" MaxWidth="640" HorizontalAlignment="Left">

            <!-- 账户（FR-03） -->
            <TextBlock Text="账户" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Background="White" CornerRadius="6" Padding="14,10" BorderBrush="#E1DFDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="邮箱" Foreground="#6B6B6B" FontSize="11" />
                    <TextBlock Text="{Binding AccountEmail}" Margin="0,0,0,8" />
                    <TextBlock Text="接入通道" Foreground="#6B6B6B" FontSize="11" />
                    <TextBlock Text="{Binding Channel}" Margin="0,0,0,8" />
                    <TextBlock Text="上次同步" Foreground="#6B6B6B" FontSize="11" />
                    <TextBlock Text="{Binding LastSync}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="清除本地数据…" Padding="10,5" Click="OnClearDataClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 同步 -->
            <TextBlock Text="同步" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="White" CornerRadius="6" Padding="14,10" BorderBrush="#E1DFDD" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="同步间隔（分钟，1–60）" Width="220" VerticalAlignment="Center" />
                        <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=LostFocus}" Width="80"
                                 HorizontalAlignment="Left" />
                    </DockPanel>
                    <CheckBox Content="启动时立即同步" IsChecked="{Binding SyncOnStartup, Mode=TwoWay}" Margin="0,8,0,2" />
                </StackPanel>
            </Border>

            <!-- 通知（FR-14 设置项） -->
            <TextBlock Text="通知" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="White" CornerRadius="6" Padding="14,10" BorderBrush="#E1DFDD" BorderThickness="1">
                <StackPanel>
                    <CheckBox Content="P0 紧急通知（逐封弹窗）" IsChecked="{Binding NotifyP0, Mode=TwoWay}" Margin="0,2" />
                    <CheckBox Content="P1 重要通知（≥3 封聚合）" IsChecked="{Binding NotifyP1, Mode=TwoWay}" Margin="0,8,0,2" />
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Text="勿扰时段（如 23:00-07:00，留空禁用）" Width="280" VerticalAlignment="Center" />
                        <TextBox Text="{Binding QuietHours, UpdateSourceTrigger=LostFocus}" Width="140"
                                 HorizontalAlignment="Left" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 外观（NFR-12） -->
            <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="White" CornerRadius="6" Padding="14,10" BorderBrush="#E1DFDD" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="语言（重启后完全生效）" Width="220" VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageBox" Width="140" HorizontalAlignment="Left"
                                  SelectedIndex="0" SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Content="跟随系统" Tag="auto" />
                            <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Text="主题" Width="220" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" Width="140" HorizontalAlignment="Left"
                                  SelectedIndex="0" SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="跟随系统" Tag="auto" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 自定义类别（S14-C/CHG-012） -->
            <TextBlock Text="自定义类别" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="White" CornerRadius="6" Padding="14,10" BorderBrush="#E1DFDD" BorderThickness="1">
                <StackPanel>
                    <ItemsControl x:Name="CustomCategoriesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="删除" Style="{StaticResource GhostButton}"
                                            Padding="8,2" FontSize="11" Click="OnDeleteCategoryClick" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="6"
                                                Background="{Binding ColorHex, Converter={StaticResource CategoryBrush}}">
                                            <TextBlock Text="{Binding Icon}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,8" Background="#E1DFDD" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NewCategoryName" Width="150" Style="{StaticResource RoundedTextBox}"
                                 AutomationProperties.Name="新类别名称" />
                        <TextBox x:Name="NewCategoryIcon" Width="44" Margin="6,0,0,0"
                                 Style="{StaticResource RoundedTextBox}" Text="📌" TextAlignment="Center"
                                 AutomationProperties.Name="新类别图标" />
                        <ComboBox x:Name="NewCategoryColor" Width="100" Margin="6,0,0,0" SelectedIndex="0">
                            <ComboBoxItem Tag="#3A7BD5">蓝</ComboBoxItem>
                            <ComboBoxItem Tag="#0E9F6E">绿</ComboBoxItem>
                            <ComboBoxItem Tag="#7C5CDB">紫</ComboBoxItem>
                            <ComboBoxItem Tag="#D97706">橙</ComboBoxItem>
                            <ComboBoxItem Tag="#0E7490">青</ComboBoxItem>
                            <ComboBoxItem Tag="#C2417D">粉</ComboBoxItem>
                        </ComboBox>
                        <Button Content="添加" Style="{StaticResource PrimaryButton}" Padding="14,5"
                                Margin="8,0,0,0" FontSize="12" Click="OnAddCategoryClick" />
                    </StackPanel>
                    <TextBlock Text="删除类别时，该类邮件归入「其他」，指向它的规则将一并删除。"
                               FontSize="11" Foreground="{StaticResource BrushTextTertiary}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 高级 -->
            <TextBlock Text="高级" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="White" CornerRadius="6" Padding="14,10" BorderBrush="#E1DFDD" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="AutostartBox" Content="开机自启" Margin="0,2" Checked="OnAutostartChecked" Unchecked="OnAutostartUnchecked" />
                    <CheckBox Content="诊断日志（Debug 级，含完整发件人地址）" IsChecked="{Binding Diagnostics, Mode=TwoWay}"
                              Margin="0,8,0,2" />
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Text="正文缓存上限（MB）" Width="220" VerticalAlignment="Center" />
                        <TextBox Text="{Binding BodyLimitMb, UpdateSourceTrigger=LostFocus}" Width="100"
                                 HorizontalAlignment="Left" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 关于/更新（S15，08 §4.3：Velopack + GitHub Releases） -->
            <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Border Background="White" CornerRadius="6" Padding="14,10" BorderBrush="#E1DFDD" BorderThickness="1"
                    Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="当前版本" Width="220" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                        <Button Content="检查更新" Padding="10,5" Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding CanCheckUpdate}" />
                        <Button Content="重启并安装更新" Padding="10,5" Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyUpdateCommand}"
                                Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding UpdateStatus}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#6B6B6B" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                    <TextBlock Text="更新经 GitHub Releases 分发，只接收正式版；完整安装包下载后静默升级并自动重启。开发模式（源码运行）下不可用。"
                               FontSize="11" Foreground="{StaticResource BrushTextTertiary}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
