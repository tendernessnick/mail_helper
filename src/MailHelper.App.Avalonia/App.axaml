<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MailHelper.App.Avalonia.App"
             RequestedThemeVariant="Default">
  <!-- RequestedThemeVariant=Default：浅深色跟随系统（docs/10 §8.7；NFR-08 Mac 等价） -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MailHelper.App.Avalonia/Themes/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MailHelper.App.Avalonia/Themes/ShellStyles.axaml" />
  </Application.Styles>
</Application>
