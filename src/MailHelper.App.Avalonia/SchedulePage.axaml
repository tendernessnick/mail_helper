<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailHelper.ViewModels;assembly=MailHelper.ViewModels"
             xmlns:app="clr-namespace:MailHelper.App.Avalonia" x:Class="MailHelper.App.Avalonia.SchedulePage">
  <UserControl.Resources><app:InverseBoolConverter x:Key="InverseBool" /></UserControl.Resources>
  <Grid Margin="28,24" MaxWidth="1120" RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
      <StackPanel Spacing="7">
        <TextBlock Text="留一点从容给截止日" FontSize="11" Foreground="{DynamicResource BrushPrimary}" />
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="日程" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
          <Border Background="{DynamicResource BrushPrimaryTint}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
            <TextBlock Text="{Binding OpenCount, StringFormat='{}{0} 项待完成'}" FontSize="12" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="Canvas 作业截止日期自动汇集在这里。完成一项，就少一件挂心的事。" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="navItem" Content="⟳ 刷新" Padding="16,9" Margin="20,0,0,0" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
    </Grid>
    <Panel Grid.Row="1">
      <ScrollViewer IsVisible="{Binding HasItems}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,4,0"><ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ScheduleGroupViewModel}">
            <StackPanel Margin="0,0,0,22">
              <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10">
                <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Grid.Column="1" Text="{Binding HeaderBadge}" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScheduleItemRowViewModel}">
                  <Border Background="{DynamicResource BrushSurface}" CornerRadius="12" Padding="20,16" Margin="0,0,0,8" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,16,10" ToolTip.Tip="{Binding Title}" />
                      <Border Grid.Column="1" Background="{DynamicResource BrushPrimaryTint}" CornerRadius="6" Padding="9,5" VerticalAlignment="Top">
                        <TextBlock Text="{Binding RelativeText}" FontSize="12" FontWeight="SemiBold" Classes="relativeTime" Classes.overdue="{Binding IsOverdue}" />
                      </Border>
                      <StackPanel Grid.Row="1" Spacing="5" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding CourseDisplay}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                        <WrapPanel>
                          <TextBlock Text="{Binding DueText}" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" />
                          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" Margin="10,0,0,0" IsVisible="{Binding IsOpen, Converter={StaticResource InverseBool}}" />
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="navItem" Content="Canvas ↗" Padding="10,6" Click="OnOpenLink" Tag="{Binding Link}" IsVisible="{Binding HasLink}" />
                        <Button Classes="primaryAction" Content="完成" Padding="12,6" Command="{Binding $parent[UserControl].DataContext.CompleteCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsOpen}" />
                        <Button Classes="navItem" Content="忽略" Padding="10,6" Command="{Binding $parent[UserControl].DataContext.IgnoreCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsOpen}" />
                        <Button Classes="navItem" Content="恢复" Padding="12,6" Command="{Binding $parent[UserControl].DataContext.RestoreCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsOpen, Converter={StaticResource InverseBool}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="32" Spacing="10" IsVisible="{Binding HasItems, Converter={StaticResource InverseBool}}">
        <Border Width="64" Height="64" Background="{DynamicResource BrushPrimaryTint}" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,10">
          <Path Data="M 5,8 L 27,8 27,28 5,28 Z M 10,4 L 10,12 M 22,4 L 22,12 M 5,16 L 27,16 M 11,22 L 14,25 21,19" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource BrushPrimary}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
        <TextBlock Text="暂时没有待安排的事" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
        <TextBlock Text="同步邮箱后，识别到的 Canvas 作业截止日期会自动出现在这里。" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Panel>
    <TextBlock Grid.Row="2" Classes="statusText" Text="{Binding LastSyncText}" Margin="2,12,0,0" FontSize="11" />
  </Grid>
</UserControl>
