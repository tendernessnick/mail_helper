<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      S13-C 设计令牌（prompts/S13 §B）：全部控件样式只引用此字典，不留魔法数。
      色板基线 = Fluent（05 章 §5.1 语义色保留），层级化背景 + 主色 #17786B。
    -->

    <!-- ============ 色板 ============ -->
    <Color x:Key="ColorPrimary">#17786B</Color>
    <Color x:Key="ColorPrimaryDeep">#116356</Color>
    <Color x:Key="ColorPrimaryTint">#E5F0E9</Color>
    <Color x:Key="ColorAccentWarning">#F7630C</Color>
    <Color x:Key="ColorAccentDanger">#D13438</Color>

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryDeep}" />
    <SolidColorBrush x:Key="BrushPrimaryTint" Color="{StaticResource ColorPrimaryTint}" />
    <SolidColorBrush x:Key="BrushWindowBg" Color="#F5F4EF" />
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#F8F9F5" />
    <SolidColorBrush x:Key="BrushTopBar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushDivider" Color="#E2E6DF" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#202B2B" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#53635B" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="#5B6B62" />
    <SolidColorBrush x:Key="BrushRowHover" Color="#EDF2EB" />
    <SolidColorBrush x:Key="BrushRowSelected" Color="#E5F0E9" />
    <SolidColorBrush x:Key="BrushUnreadBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushUnreadDot" Color="#17786B" />
    <SolidColorBrush x:Key="BrushBadgeBg" Color="#E2E8DE" />
    <SolidColorBrush x:Key="BrushDanger" Color="#AA333A" />

    <SolidColorBrush x:Key="BrushOnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushControlBorder" Color="#A0B2A5" />
    <SolidColorBrush x:Key="BrushDisabledText" Color="#5E6D64" />
    <SolidColorBrush x:Key="BrushDisabledBg" Color="#E7EBE4" />
    <SolidColorBrush x:Key="BrushP0Text" Color="#AA333A" />
    <SolidColorBrush x:Key="BrushP1Text" Color="#945000" />
    <SolidColorBrush x:Key="BrushP2Text" Color="#235F78" />
    <SolidColorBrush x:Key="BrushP3Text" Color="#53645A" />

    <!-- 类别色（左栏图标底/头像fallback；07 类别语义色） -->
    <SolidColorBrush x:Key="BrushCatCourse" Color="#3A7BD5" />
    <SolidColorBrush x:Key="BrushCatCareer" Color="#0E9F6E" />
    <SolidColorBrush x:Key="BrushCatAdmin" Color="#7C5CDB" />
    <SolidColorBrush x:Key="BrushCatFinance" Color="#D97706" />
    <SolidColorBrush x:Key="BrushCatAnnounce" Color="#0E7490" />
    <SolidColorBrush x:Key="BrushCatSubscription" Color="#748079" />
    <SolidColorBrush x:Key="BrushCatOther" Color="#64748B" />

    <SolidColorBrush x:Key="BrushSidebar" Color="#EDEFE8" />
    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="FontApp">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontAppDisplay">Segoe UI Variable Display, Segoe UI Semibold, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13.5</sys:Double>
    <sys:Double x:Key="FontSizeRow">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ============ 基础文本 ============ -->
    <Style x:Key="AppText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource AppText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
    </Style>

    <!-- 通用按钮、输入与弹出层统一在 Controls.xaml，避免浅深主题模板分叉。 -->

    <!-- ============ 顶栏导航胶囊 ============ -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Text" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushPrimaryTint}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 列表容器（去默认蓝框，圆角行） ============ -->
    <Style x:Key="MailListItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="7,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="10" BorderBrush="Transparent" BorderThickness="1">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowHover}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowSelected}" /><Setter TargetName="Bg" Property="BorderBrush" Value="#C8DBCE" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushPrimary}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="CategoryListItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource RadiusMedium}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushPrimaryTint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 计数徽章 ============ -->
    <Style x:Key="CategoryBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Background" Value="{StaticResource BrushBadgeBg}" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="22" />
    </Style>
</ResourceDictionary>
