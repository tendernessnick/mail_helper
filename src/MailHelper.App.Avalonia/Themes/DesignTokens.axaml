                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!--
    MS3 设计令牌（docs/10 §8.7）：与 WPF DesignTokens.xaml（S13-C）同源的暖纸 / 松绿设计系统。
    浅色 = WPF 令牌逐值一致；深色 = Fluent 深色板同比例提亮（05 §5.1：P0 #FF5C5C 等）。
    主题感知令牌必须以 DynamicResource 消费。
  -->

  <ResourceDictionary.ThemeDictionaries>
