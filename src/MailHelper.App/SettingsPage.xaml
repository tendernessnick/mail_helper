<UserControl x:Class="MailHelper.App.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:MailHelper.App">
    <UserControl.Resources>
        <app:CategoryToBrushConverter x:Key="CategoryBrush" /><app:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource AppText}"><Setter Property="FontSize" Value="13" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource AppText}">
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource AppText}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="22" /><Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheck}"><Setter Property="MinHeight" Value="32" /></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}"><Setter Property="MinHeight" Value="36" /></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="880" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="你的邮箱，你的节奏" FontSize="11" Foreground="{DynamicResource BrushPrimary}" />
                <TextBlock Text="偏好设置" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8" />
                <TextBlock Text="管理账户、同步与提醒。文本输入在离开输入框后保存。" Style="{StaticResource SettingHint}" />
            </StackPanel>
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <DockPanel><TextBlock Text="账户与连接" Style="{StaticResource SectionTitle}" /><TextBlock Text="本机 Outlook" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource BrushPrimary}" FontSize="12" /></DockPanel>
                    <TextBlock Text="{Binding AccountEmail}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="接入通道" Style="{StaticResource SettingHint}" /><TextBlock Text="{Binding Channel}" TextWrapping="Wrap" Margin="0,4,20,0" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="上次同步" Style="{StaticResource SettingHint}" /><TextBlock Text="{Binding LastSync}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="同步" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="自动同步间隔" /><TextBlock Text="每 1–60 分钟检查一次新邮件" Style="{StaticResource SettingHint}" Margin="0,4,0,0" /></StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding IntervalMinutes, UpdateSourceTrigger=LostFocus}" Width="100" VerticalAlignment="Center" AutomationProperties.Name="同步间隔（分钟）" />
                </Grid>
                <CheckBox Content="启动时立即同步" IsChecked="{Binding SyncOnStartup, Mode=TwoWay}" />
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="通知与勿扰" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="P0 紧急邮件逐封通知" IsChecked="{Binding NotifyP0, Mode=TwoWay}" />
                <CheckBox Content="P1 重要邮件通知（3 封及以上合并）" IsChecked="{Binding NotifyP1, Mode=TwoWay}" Margin="0,4,0,14" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="勿扰时段" /><TextBlock Text="如 23:00-07:00，留空则始终允许通知" Style="{StaticResource SettingHint}" Margin="0,4,0,0" /></StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding QuietHours, UpdateSourceTrigger=LostFocus}" Width="150" VerticalAlignment="Center" AutomationProperties.Name="勿扰时段" />
                </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="日程与提醒" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="自动识别 Canvas 作业截止日期" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" />
                <CheckBox Content="临近截止时提醒我" IsChecked="{Binding ScheduleReminderEnabled, Mode=TwoWay}" Margin="0,4,0,14" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="提前提醒" /><TextBlock Text="截止前 1–168 小时提醒，同一截止时间只提醒一次" Style="{StaticResource SettingHint}" Margin="0,4,0,0" /></StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding ScheduleReminderHours, UpdateSourceTrigger=LostFocus}" Width="100" VerticalAlignment="Center" AutomationProperties.Name="提前提醒（小时）" />
                </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="外观与语言" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="界面语言" /><TextBlock Text="重启后完全生效" Style="{StaticResource SettingHint}" Margin="0,4,0,0" /></StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="150" SelectedIndex="0" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="跟随系统" Tag="auto" /><ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="主题" /><TextBlock Text="重启后生效" Style="{StaticResource SettingHint}" Margin="0,4,0,0" /></StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="150" SelectedIndex="0" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="跟随系统" Tag="auto" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" />
                    </ComboBox>
                </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="自定义类别" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="为自己的学习与工作，留一个专属位置。" Style="{StaticResource SettingHint}" Margin="0,0,0,14" />
                <ItemsControl x:Name="CustomCategoriesList"><ItemsControl.ItemTemplate><DataTemplate>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="删除" Style="{StaticResource GhostButton}" Padding="10,5" Click="OnDeleteCategoryClick" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="{Binding ColorHex, Converter={StaticResource CategoryBrush}}"><TextBlock Text="{Binding Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <WrapPanel Margin="0,2,0,0">
                    <StackPanel Margin="0,0,8,8"><TextBlock Text="名称" Style="{StaticResource SettingHint}" Margin="0,0,0,5" /><TextBox x:Name="NewCategoryName" Width="190" AutomationProperties.Name="新类别名称" /></StackPanel>
                    <StackPanel Margin="0,0,8,8"><TextBlock Text="图标" Style="{StaticResource SettingHint}" Margin="0,0,0,5" /><TextBox x:Name="NewCategoryIcon" Width="56" Text="📌" TextAlignment="Center" AutomationProperties.Name="新类别图标" /></StackPanel>
                    <StackPanel Margin="0,0,8,8"><TextBlock Text="颜色" Style="{StaticResource SettingHint}" Margin="0,0,0,5" /><ComboBox x:Name="NewCategoryColor" Width="100" SelectedIndex="0">
                        <ComboBoxItem Tag="#3A7BD5">蓝</ComboBoxItem><ComboBoxItem Tag="#0E9F6E">绿</ComboBoxItem><ComboBoxItem Tag="#7C5CDB">紫</ComboBoxItem><ComboBoxItem Tag="#D97706">橙</ComboBoxItem><ComboBoxItem Tag="#0E7490">青</ComboBoxItem><ComboBoxItem Tag="#C2417D">粉</ComboBoxItem>
                    </ComboBox></StackPanel>
                    <Button Content="添加类别" Style="{StaticResource PrimaryButton}" Padding="14,9" VerticalAlignment="Bottom" Margin="0,0,0,8" Click="OnAddCategoryClick" />
                </WrapPanel>
                <TextBlock Text="删除类别后，邮件会归入「其他」，关联规则也会删除。" Style="{StaticResource SettingHint}" Margin="0,4,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="启动与本机存储" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="AutostartBox" Content="登录电脑后自动启动" Checked="OnAutostartChecked" Unchecked="OnAutostartUnchecked" />
                <Grid Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="正文缓存上限" /><TextBlock Text="单位 MB，邮件正文只保存在本机" Style="{StaticResource SettingHint}" Margin="0,4,0,0" /></StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding BodyLimitMb, UpdateSourceTrigger=LostFocus}" Width="100" VerticalAlignment="Center" AutomationProperties.Name="正文缓存上限（MB）" />
                </Grid>
                <CheckBox Content="启用诊断日志" IsChecked="{Binding Diagnostics, Mode=TwoWay}" />
                <TextBlock Text="仅排错时启用；诊断日志可能包含发件人地址。" Style="{StaticResource SettingHint}" Margin="26,3,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <DockPanel Margin="0,0,0,10"><TextBlock Text="关于 MailHelper" Style="{StaticResource SectionTitle}" /><TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion, StringFormat=v{0}}" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Right" /></DockPanel>
                <WrapPanel><Button Content="检查更新" Style="{StaticResource GhostButton}" Padding="14,9" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding CanCheckUpdate}" Margin="0,0,8,8" />
                    <Button Content="重启并安装更新" Style="{StaticResource PrimaryButton}" Padding="14,9" Command="{Binding ApplyUpdateCommand}" Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SettingHint}" Margin="0,2,0,8" />
                <TextBlock Text="只接收正式版。下载完整安装包后，静默升级并自动重启；源码开发模式下不可用。" Style="{StaticResource SettingHint}" />
            </StackPanel></Border>
            <Border Style="{StaticResource SettingsCard}" Background="{DynamicResource BrushSurfaceAlt}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="清除本地数据" FontWeight="SemiBold" /><TextBlock Text="移除本机邮件缓存、规则和设置，随后退出应用。" Style="{StaticResource SettingHint}" Margin="0,5,0,0" /></StackPanel>
                <Button Grid.Column="1" Content="清除数据…" Style="{StaticResource GhostButton}" Padding="12,8" VerticalAlignment="Center" Foreground="{DynamicResource BrushDanger}" Click="OnClearDataClick" />
            </Grid></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
