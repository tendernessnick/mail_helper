<Window x:Class="MailHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MailHelper.App"
        xmlns:vm="clr-namespace:MailHelper.App.ViewModels"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MailHelper" Height="780" Width="1320" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BrushWindowBg}"
        FontFamily="{StaticResource FontApp}">
    <Window.Resources>
        <app:ImportanceToBrushConverter x:Key="ImportanceBrush" />
        <app:CategoryToBrushConverter x:Key="CategoryBrush" />
        <app:BoolToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <app:CountToBadgeConverter x:Key="CountBadge" />
        <app:CountToEmptyVisibilityConverter x:Key="CountToEmptyVis" />
        <app:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <app:CountToUnreadNameConverter x:Key="UnreadName" />
        <app:InverseBoolConverter x:Key="InverseBool" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />

        <!-- 邮件行（S13-C 重设计）：类别色头像 + 未读点 + 双行排版 + 时间右对齐 -->
        <DataTemplate x:Key="MailItemTemplate" DataType="{x:Type vm:MailItemViewModel}">
            <Border Padding="12,9,12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 类别色头像：发件人首字母 -->
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 主体三行：发件人 / 主题 / 预览 -->
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushUnreadDot}"
                                     VerticalAlignment="Center" Margin="0,1,6,0">
                                <Ellipse.Visibility>
                                    <Binding Path="IsRead" Converter="{StaticResource InverseBoolVis}" />
                                </Ellipse.Visibility>
                            </Ellipse>
                            <TextBlock Text="{Binding FromDisplay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       MaxWidth="360" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AppText}">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Subject}" FontSize="{StaticResource FontSizeRow}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AppText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="{Binding Importance, Converter={StaticResource ImportanceBrush}}"
                                    CornerRadius="4" Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImportanceText}" FontSize="10.5" Foreground="White"
                                           FontWeight="SemiBold" Padding="0,1" />
                            </Border>
                            <TextBlock Text="📎" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTextTertiary}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 右缘：时间 -->
                    <TextBlock Grid.Column="2" Text="{Binding ReceivedText}" FontSize="11"
                               VerticalAlignment="Top" Margin="4,1,0,0"
                               Foreground="{StaticResource BrushTextTertiary}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding SyncNowCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- ============ Onboarding（S13-C 精化：居中卡片 + 主行动按钮） ============ -->
        <Grid Visibility="{Binding IsOnboarding, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460"
                    Background="{StaticResource BrushSurface}" CornerRadius="{StaticResource RadiusLarge}"
                    BorderBrush="{StaticResource BrushDivider}" BorderThickness="1" Padding="44,40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.12" Color="#1B2A4A" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource BrushPrimary}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="📮" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MailHelper 邮箱管家" FontSize="22" FontWeight="SemiBold"
                               FontFamily="{StaticResource FontAppDisplay}" HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                    <TextBlock Text="让港校邮箱里的大事小事，各归其位"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,6,0,26" />
                    <Button Content="连接学校邮箱" Style="{StaticResource PrimaryButton}" FontSize="15"
                            Padding="18,10" HorizontalAlignment="Center"
                            Command="{Binding ConnectCommand}" />
                    <TextBlock Text="需要本机已安装并登录「经典版 Outlook」（Office 桌面版），MailHelper 经它同步学校邮箱"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5"
                               HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="330" />
                    <CheckBox IsChecked="{Binding PrivacyAccepted}" Style="{StaticResource ModernCheck}"
                              Margin="0,14,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="同意《隐私说明》：邮件数据仅保存在本机，分类完全在本地完成，不上传任何服务器"
                                   TextWrapping="Wrap" MaxWidth="330" />
                    </CheckBox>
                    <TextBlock Text="{Binding SyncStatusText}" Foreground="{StaticResource BrushDanger}"
                               Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 三栏主界面（05 §3.2） ============ -->
        <Grid Visibility="{Binding IsOnboarding, Converter={StaticResource InvBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏（S14-B：Grid 三段布局——品牌导航 | 搜索居中 | 未读筛选，最大化不散架） -->
            <Border Grid.Row="0" Background="{StaticResource BrushTopBar}"
                    BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="2,0,14,0">
                            <Run Text="📮" FontSize="17" />
                            <Run Text="MailHelper" FontSize="15" FontWeight="Bold"
                                 FontFamily="{StaticResource FontAppDisplay}" Foreground="{StaticResource BrushTextPrimary}" />
                        </TextBlock>
                        <RadioButton Content="收件箱" GroupName="Nav" IsChecked="True" Margin="0,0,2,0"
                                     Padding="14,6" Style="{StaticResource NavTab}"
                                     Command="{Binding ShowInboxCommand}" />
                        <RadioButton Content="规则" GroupName="Nav" Margin="0,0,2,0"
                                     Padding="14,6" Style="{StaticResource NavTab}"
                                     Command="{Binding ShowRulesCommand}" />
                        <RadioButton Content="设置" GroupName="Nav"
                                     Padding="14,6" Style="{StaticResource NavTab}"
                                     Command="{Binding ShowSettingsCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="380" VerticalAlignment="Center" Style="{StaticResource RoundedTextBox}"
                                 AutomationProperties.Name="搜索框">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="搜索" Style="{StaticResource GhostButton}"
                                Command="{Binding SearchCommand}" Margin="6,0,0,0" />
                        <Button Content="清除" Style="{StaticResource GhostButton}"
                                Command="{Binding ClearSearchCommand}" Margin="6,0,0,0"
                                Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <CheckBox Content="仅未读" IsChecked="{Binding UnreadOnly}" Style="{StaticResource ModernCheck}"
                                  Command="{Binding ToggleUnreadOnlyCommand}" VerticalAlignment="Center"
                                  Margin="0,0,14,0" />
                        <TextBlock Text="Ctrl+F 搜索 · Ctrl+R 同步" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextTertiary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 收件箱（三栏） -->
            <Grid Grid.Row="1" Visibility="{Binding IsInboxView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="228" MinWidth="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="MiddleColumn" Width="3*" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="2*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：类别导航（S13-C：图标块 + 徽章） -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,0,1,0">
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource CategoryListItem}"
                             AutomationProperties.Name="类别导航"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5" Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center"
                                            Background="{Binding CategoryId, Converter={StaticResource CategoryBrush}}">
                                        <ContentControl Content="{Binding Icon}" FontSize="13"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Focusable="False" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" Margin="9,0,4,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource CategoryBadge}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count, Converter={StaticResource CountBadge}}"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   AutomationProperties.AutomationId="unread-badge"
                                                   AutomationProperties.Name="{Binding Count, Converter={StaticResource UnreadName}}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- 中栏：邮件列表（虚拟化 + 圆角行） -->
                <Grid Grid.Column="2" Background="{StaticResource BrushSurface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" Height="2.5" IsIndeterminate="True" BorderThickness="0"
                                 Foreground="{StaticResource BrushPrimary}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Mails}" SelectedItem="{Binding SelectedMail, Mode=TwoWay}"
                             ItemTemplate="{StaticResource MailItemTemplate}"
                             ItemContainerStyle="{StaticResource MailListItem}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="邮件列表" />
                    <!-- 空态（05 §6） -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Mails.Count, Converter={StaticResource CountToEmptyVis}}">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource BrushPrimaryTint}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="🗂" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="该分类暂无邮件" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13" />
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- 右栏：阅读窗格（WebView2 沙箱，禁脚本） -->
                <Grid Grid.Column="4" Background="{StaticResource BrushSurface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="18,14,18,8" DataContext="{Binding SelectedMail}"
                                Visibility="{Binding SelectedMail, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                                   FontFamily="{StaticResource FontAppDisplay}"
                                   TextWrapping="Wrap" Text="{Binding Subject}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                            <Border Width="26" Height="26" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{Binding Category, Converter={StaticResource CategoryBrush}}">
                                <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Background="{Binding Importance, Converter={StaticResource ImportanceBrush}}"
                                    CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImportanceText}" FontSize="10.5" Foreground="White"
                                           FontWeight="SemiBold" Padding="0,1" />
                            </Border>
                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding FromDisplay, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="420" />
                        </StackPanel>
                        <Separator Margin="0,12,0,0" Background="{StaticResource BrushDivider}" />
                    </StackPanel>
                    <wv:WebView2 x:Name="Reader" Grid.Row="1" DefaultBackgroundColor="White" />
                    <!-- RISK-04 降级：WebView2 初始化失败时以提示替代白屏（完整纯文本模式随 S9 设置页） -->
                    <TextBlock x:Name="ReaderFallback" Grid.Row="1" Visibility="Collapsed"
                               Margin="18,12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextTertiary}" />
                    <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0"
                            Padding="14,7">
                        <DockPanel>
                            <Button x:Name="ChangeCategoryButton" DockPanel.Dock="Left" Content="改为…"
                                    Style="{StaticResource GhostButton}" Padding="12,4" Margin="0,0,10,0"
                                    FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"
                                    Click="OnChangeCategoryClick"
                                    Visibility="{Binding SelectedMail, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="改判立即生效并自动学习同发件人规则；外链在本窗格内不可跳转（安全设置）"
                                       FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource BrushTextTertiary}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 规则管理（FR-10 / 05 §3.3）与设置（FR-03 / 05 §3.4）：DI 页面经代码后置挂载 -->
            <ContentControl Grid.Row="1" x:Name="RulesHost"
                            Visibility="{Binding IsRulesView, Converter={StaticResource BoolToVis}}" />
            <ContentControl Grid.Row="1" x:Name="SettingsHost"
                            Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVis}}" />

            <!-- 状态栏（S13-C：状态灯 + 主行动按钮） -->
            <Border Grid.Row="2" Background="{StaticResource BrushTopBar}"
                    BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0"
                    Padding="14,6">
                <DockPanel>
                    <Button Content="⟳ 立即同步" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Padding="14,5" FontSize="12" Command="{Binding SyncNowCommand}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#2E9E5B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource BrushPrimary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SyncStatusText}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
