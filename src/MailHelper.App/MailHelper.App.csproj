<Project Sdk="Microsoft.NET.Sdk">
  <!-- 表示层（03 章 L1）：WPF + MVVM + 通用主机（总控指令四.1） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework> <!-- WinRT 平台版本：Toolkit Toast 桌面 API（04 §4） -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- 04 §4 指定：Toast 通知（ToastContentBuilder，launch 直达）与托盘（角标 DrawText） -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MailHelper.Core\MailHelper.Core.csproj" />
    <ProjectReference Include="..\MailHelper.Core.Services\MailHelper.Core.Services.csproj" />
    <ProjectReference Include="..\MailHelper.Infrastructure\MailHelper.Infrastructure.csproj" />
  </ItemGroup>
</Project>
