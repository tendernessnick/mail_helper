<UserControl x:Class="MailHelper.App.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailHelper.ViewModels;assembly=MailHelper.ViewModels"
             xmlns:app="clr-namespace:MailHelper.App">
    <UserControl.Resources>
        <!-- UserControl 构造期解析 StaticResource：自带转换器实例（不能依赖 Window 资源） -->
        <app:BoolToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolConverter x:Key="InverseBool" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏（05 §3.3）：新建 + 筛选 + 试跑预览 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="+ 新建规则" Padding="10,4" Click="OnNewRuleClick" />
                <Button Content="试跑预览（最近 100 封）" Padding="10,4" Margin="8,0,0,0"
                        Command="{Binding PreviewCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="筛选：" VerticalAlignment="Center" Foreground="#6B6B6B" />
                <ComboBox x:Name="FilterBox" Width="110" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="全部" Tag="All" />
                    <ComboBoxItem Content="内置" Tag="Builtin" />
                    <ComboBoxItem Content="自定义" Tag="User" />
                    <ComboBoxItem Content="反馈生成" Tag="Feedback" />
                </ComboBox>
            </StackPanel>
            <TextBlock Text="分类规则" FontWeight="SemiBold" FontSize="16" />
        </DockPanel>

        <!-- 列表表头 -->
        <Grid Grid.Row="1" Background="#F3F2F1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.6*" />
                <ColumnDefinition Width="0.6*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="名称" FontWeight="SemiBold" Margin="8,4" />
            <TextBlock Grid.Column="1" Text="类型" FontWeight="SemiBold" Margin="4,4" />
            <TextBlock Grid.Column="2" Text="模式" FontWeight="SemiBold" Margin="4,4" />
            <TextBlock Grid.Column="3" Text="类别" FontWeight="SemiBold" Margin="4,4" />
            <TextBlock Grid.Column="4" Text="权重" FontWeight="SemiBold" Margin="4,4" />
            <TextBlock Grid.Column="5" Text="启用" FontWeight="SemiBold" Margin="4,4" />
            <TextBlock Grid.Column="6" Text="来源" FontWeight="SemiBold" Margin="4,4" />
            <TextBlock Grid.Column="7" Text="操作" FontWeight="SemiBold" Margin="4,4" />
        </Grid>

        <!-- 规则列表 -->
        <ListBox Grid.Row="2" x:Name="RulesList" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 BorderThickness="1" BorderBrush="#E1DFDD"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0.6*" />
                            <ColumnDefinition Width="0.6*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="8,5,4,5"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding KindText}" Margin="4,5" Foreground="#4A4A4A" />
                        <TextBlock Grid.Column="2" Text="{Binding PatternText}" Margin="4,5"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PatternText}"
                                   Foreground="#4A4A4A" />
                        <TextBlock Grid.Column="3" Text="{Binding CategoryText}" Margin="4,5" />
                        <TextBlock Grid.Column="4" Text="{Binding Weight}" Margin="4,5" />
                        <CheckBox Grid.Column="5" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="4,5"
                                  IsEnabled="{Binding IsBuiltin, Converter={StaticResource InverseBool}}"
                                  HorizontalAlignment="Center" />
                        <Border Grid.Column="6" CornerRadius="6" Background="#E1DFDD" Padding="6,1"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,2">
                            <TextBlock Text="{Binding SourceTag}" FontSize="10" />
                        </Border>
                        <Button Grid.Column="7" Content="删除" FontSize="11" Padding="6,1" Margin="4,2"
                                Visibility="{Binding IsBuiltin, Converter={StaticResource InverseBoolVis}}"
                                Click="OnDeleteClick" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 试跑预览结果（FR-10） -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding PreviewSummary}" DockPanel.Dock="Top" Foreground="#0078D4"
                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
            <ListBox ItemsSource="{Binding PreviewLines}" Height="140" FontSize="12"
                     Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"
                     BorderThickness="1" BorderBrush="#E1DFDD" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>
    </Grid>
</UserControl>
