<Window x:Class="MailHelper.App.RuleEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="规则编辑" Width="500" Height="650" MinWidth="450" MinHeight="500" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{DynamicResource BrushWindowBg}" FontFamily="{StaticResource FontApp}">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource AppText}"><Setter Property="FontSize" Value="13" /></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}"><Setter Property="MinHeight" Value="38" /><Setter Property="Margin" Value="0,6,0,18" /></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38" /><Setter Property="Margin" Value="0,6,0,18" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="分类偏好" Foreground="{DynamicResource BrushPrimary}" FontSize="11" />
            <TextBlock Text="设计一条分类规则" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,7" />
            <TextBlock Text="告诉 MailHelper，什么样的邮件应该去哪里。" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1" CornerRadius="12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="匹配方式" FontWeight="SemiBold" />
                    <ComboBox x:Name="KindBox" SelectedIndex="0">
                        <ComboBoxItem Content="发件人地址" Tag="SenderAddress" /><ComboBoxItem Content="发件人域名" Tag="SenderDomain" />
                        <ComboBoxItem Content="主题关键词" Tag="SubjectKeyword" /><ComboBoxItem Content="主题正则" Tag="SubjectRegex" />
                    </ComboBox>
                    <TextBlock Text="匹配内容" FontWeight="SemiBold" />
                    <TextBox x:Name="PatternBox" AutomationProperties.Name="规则匹配内容" />
                    <TextBlock Text="目标类别" FontWeight="SemiBold" />
                    <ComboBox x:Name="CategoryBox" SelectedIndex="1" />
                    <TextBlock Text="重要度建议" FontWeight="SemiBold" />
                    <ComboBox x:Name="ImportanceBox" SelectedIndex="0" />
                    <TextBlock Text="规则权重 · 0–15" FontWeight="SemiBold" />
                    <TextBox x:Name="WeightBox" AutomationProperties.Name="规则权重" />
                    <CheckBox x:Name="EnabledBox" Content="保存后启用这条规则" IsChecked="True" Style="{StaticResource ModernCheck}" Margin="0,0,0,6" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="保存规则" Style="{StaticResource PrimaryButton}" Padding="20,10" Click="OnSaveClick" />
            <Button DockPanel.Dock="Right" Content="取消" Style="{StaticResource GhostButton}" Padding="20,10" Margin="0,0,10,0" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
