<UserControl x:Class="MailHelper.App.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MailHelper.App">
    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource AppText}">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="RuleMeta" TargetType="TextBlock" BasedOn="{StaticResource AppText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,24" MaxWidth="1120" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="让分类更懂你" FontSize="11" Foreground="{DynamicResource BrushPrimary}" />
            <TextBlock Text="分类规则" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,7" />
            <TextBlock Text="管理匹配方式与分类偏好。新规则可以先试跑，再用于后续邮件。"
                       Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <Button Content="新建规则" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="OnNewRuleClick" />
                <Button Content="试跑选中规则" Style="{StaticResource GhostButton}" Padding="14,9" Margin="8,0,0,0"
                        Command="{Binding PreviewCommand}" ToolTip="在最近 100 封邮件中预览命中结果" />
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="规则来源" Style="{StaticResource RuleMeta}" Margin="0,0,10,0" />
                <ComboBox x:Name="FilterBox" Width="118" MinHeight="36" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="全部规则" Tag="All" /><ComboBoxItem Content="内置" Tag="Builtin" />
                    <ComboBoxItem Content="自定义" Tag="User" /><ComboBoxItem Content="反馈生成" Tag="Feedback" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <ListBox Grid.Row="2" x:Name="RulesList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel" Padding="0,0,4,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="18,15" /><Setter Property="Margin" Value="0,0,0,9" />
                    <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" /><Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate></Setter.Value></Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrushRowHover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrushRowSelected}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" /></Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <CheckBox Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource ModernCheck}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="编辑" Style="{StaticResource GhostButton}" Padding="10,5" Click="OnEditClick" Margin="0,0,6,0"
                                    Visibility="{Binding IsBuiltin, Converter={StaticResource InverseBoolVis}}" />
                            <Button Content="删除" Style="{StaticResource GhostButton}" Padding="10,5" Click="OnDeleteClick"
                                    Visibility="{Binding IsBuiltin, Converter={StaticResource InverseBoolVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,7" Margin="0,11,0,10">
                        <TextBlock Text="{Binding PatternText}" FontSize="12" FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
                    </Border>
                    <WrapPanel Grid.Row="2">
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource RuleMeta}" />
                        <TextBlock Text="  →  " Style="{StaticResource RuleMeta}" />
                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource RuleMeta}" />
                        <TextBlock Text="{Binding Weight, StringFormat= · 权重 {0}}" Style="{StaticResource RuleMeta}" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding SourceTag}" Style="{StaticResource RuleMeta}" Margin="14,0,0,0" />
                    </WrapPanel>
                </Grid>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BrushPrimaryTint}" CornerRadius="8" Padding="14,10">
                <TextBlock Text="{Binding PreviewSummary}" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" />
            </Border>
            <ListBox ItemsSource="{Binding PreviewLines}" MaxHeight="130" FontSize="12" BorderThickness="0" Margin="0,6,0,0"
                     Background="{DynamicResource BrushSurface}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </StackPanel>
    </Grid>
</UserControl>
