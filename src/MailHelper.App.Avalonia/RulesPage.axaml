<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailHelper.ViewModels;assembly=MailHelper.ViewModels"
             xmlns:app="clr-namespace:MailHelper.App.Avalonia"
             x:Class="MailHelper.App.Avalonia.RulesPage">
  <UserControl.Resources>
    <app:FilterToBoolConverter x:Key="FilterToBool" />
  </UserControl.Resources>
  <!-- 规则管理（FR-10 / 05 §3.3）：列表+筛选+启停/删除/编辑+试跑预览（VM 共享，行为与 WPF 一致） -->
  <Border Background="{DynamicResource BrushSurface}" CornerRadius="{StaticResource RadiusLarge}" Margin="12">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
      <!-- 工具行：新建/编辑/删除 + 筛选 -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <Button Classes="primaryAction" Content="+ 新建规则" Click="OnNewRule" />
        <Button Classes="navItem" Content="编辑" Click="OnEditRule" />
        <Button Classes="navItem" Content="删除选中" Command="{Binding DeleteCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="20,0,0,0" VerticalAlignment="Center">
          <RadioButton Content="全部" IsChecked="{Binding Filter, Converter={StaticResource FilterToBool}, ConverterParameter=All, Mode=TwoWay}" />
          <RadioButton Content="内置" IsChecked="{Binding Filter, Converter={StaticResource FilterToBool}, ConverterParameter=Builtin, Mode=TwoWay}" />
          <RadioButton Content="自定义" IsChecked="{Binding Filter, Converter={StaticResource FilterToBool}, ConverterParameter=User, Mode=TwoWay}" />
          <RadioButton Content="反馈生成" IsChecked="{Binding Filter, Converter={StaticResource FilterToBool}, ConverterParameter=Feedback, Mode=TwoWay}" />
        </StackPanel>
      </StackPanel>

      <!-- 规则列表 -->
      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
               SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0" MinHeight="260">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:RuleRowViewModel}">
            <Grid ColumnDefinitions="*,90,*,60,60,60,50" Margin="4,6" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="12"
                         Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding PatternText}" FontSize="12" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding CategoryText}" FontSize="12"
                         Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding Weight}" FontSize="12"
                         Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="{Binding SourceTag}" FontSize="11"
                         Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center" />
              <ToggleButton Grid.Column="6" IsChecked="{Binding Enabled, Mode=TwoWay}"
                            Content="启用" FontSize="11" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 试跑预览 -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6"
                  IsVisible="{Binding HasPreview}">
        <Border Background="{DynamicResource BrushPrimaryTint}" CornerRadius="{StaticResource RadiusMedium}" Padding="10,6">
          <TextBlock Text="{Binding PreviewSummary}" FontSize="12"
                     Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" />
        </Border>
        <ItemsControl ItemsSource="{Binding PreviewLines}" MaxHeight="180">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource BrushTextSecondary}" Margin="4,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Button Grid.Row="3" Classes="navItem" Content="试跑预览（对选中规则命中最近邮件）"
              Command="{Binding PreviewCommand}" Margin="0,10,0,0" />
    </Grid>
  </Border>
</UserControl>
