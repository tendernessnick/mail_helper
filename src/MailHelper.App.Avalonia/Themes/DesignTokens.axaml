<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!--
    MS3 设计令牌（docs/10 §8.7）：与 WPF DesignTokens.xaml（S13-C）同源的暖纸 / 松绿设计系统。
    浅色 = WPF 令牌逐值一致；深色 = Fluent 深色板同比例提亮（05 §5.1：P0 #FF5C5C 等）。
    主题感知令牌必须以 DynamicResource 消费。
  -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BrushPrimary" Color="#17786B" />
      <SolidColorBrush x:Key="BrushPrimaryHover" Color="#115F55" />
      <SolidColorBrush x:Key="BrushPrimaryTint" Color="#E5F1EB" />
      <SolidColorBrush x:Key="BrushWindowBg" Color="#F5F4EF" />
      <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#F8F9F5" />
      <SolidColorBrush x:Key="BrushTopBar" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrushDivider" Color="#E2E6DF" />
      <SolidColorBrush x:Key="BrushTextPrimary" Color="#202B2B" />
      <SolidColorBrush x:Key="BrushTextSecondary" Color="#53635B" />
      <SolidColorBrush x:Key="BrushTextTertiary" Color="#728078" />
      <SolidColorBrush x:Key="BrushRowHover" Color="#F1F4EE" />
      <SolidColorBrush x:Key="BrushRowSelected" Color="#E4EFE7" />
      <SolidColorBrush x:Key="BrushUnreadBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrushUnreadDot" Color="#17786B" />
      <SolidColorBrush x:Key="BrushBadgeBg" Color="#E7ECE5" />
      <SolidColorBrush x:Key="BrushDanger" Color="#B93C3C" />
      <SolidColorBrush x:Key="BrushSidebar" Color="#EDEFE8" />
      <SolidColorBrush x:Key="BrushAvatar" Color="#E8EDE5" />
      <SolidColorBrush x:Key="BrushOnPrimary" Color="#FFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BrushPrimary" Color="#8BC9AF" />
      <SolidColorBrush x:Key="BrushPrimaryHover" Color="#A2D9C1" />
      <SolidColorBrush x:Key="BrushPrimaryTint" Color="#263F33" />
      <SolidColorBrush x:Key="BrushWindowBg" Color="#151E1B" />
      <SolidColorBrush x:Key="BrushSurface" Color="#1E2925" />
      <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#24312B" />
      <SolidColorBrush x:Key="BrushTopBar" Color="#1E2925" />
      <SolidColorBrush x:Key="BrushDivider" Color="#34433B" />
      <SolidColorBrush x:Key="BrushTextPrimary" Color="#E7F0E9" />
      <SolidColorBrush x:Key="BrushTextSecondary" Color="#BAC9C0" />
      <SolidColorBrush x:Key="BrushTextTertiary" Color="#91A397" />
      <SolidColorBrush x:Key="BrushRowHover" Color="#27392F" />
      <SolidColorBrush x:Key="BrushRowSelected" Color="#2E4737" />
      <SolidColorBrush x:Key="BrushUnreadBg" Color="#1E2925" />
      <SolidColorBrush x:Key="BrushUnreadDot" Color="#8BC9AF" />
      <SolidColorBrush x:Key="BrushBadgeBg" Color="#304136" />
      <SolidColorBrush x:Key="BrushDanger" Color="#FF8E8E" />
      <SolidColorBrush x:Key="BrushSidebar" Color="#19251F" />
      <SolidColorBrush x:Key="BrushAvatar" Color="#304136" />
      <SolidColorBrush x:Key="BrushOnPrimary" Color="#14271D" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- ============ 重要度色卡（05 §5.1 逐值，不随主题）============ -->
  <SolidColorBrush x:Key="BrushP0" Color="#D13438" />
  <SolidColorBrush x:Key="BrushP1" Color="#F7630C" />
  <SolidColorBrush x:Key="BrushP2" Color="#0078D4" />
  <SolidColorBrush x:Key="BrushP3" Color="#8A8886" />

  <!-- ============ 类别色（07 类别语义色，与 WPF 同源）============ -->
  <SolidColorBrush x:Key="BrushCatCourse" Color="#3A7BD5" />
  <SolidColorBrush x:Key="BrushCatCareer" Color="#0E9F6E" />
  <SolidColorBrush x:Key="BrushCatAdmin" Color="#7C5CDB" />
  <SolidColorBrush x:Key="BrushCatFinance" Color="#D97706" />
  <SolidColorBrush x:Key="BrushCatAnnounce" Color="#0E7490" />
  <SolidColorBrush x:Key="BrushCatSubscription" Color="#728078" />
  <SolidColorBrush x:Key="BrushCatOther" Color="#64748B" />

  <!-- ============ 字体（系统栈：Win=Segoe UI/雅黑，mac=系统中文栈；docs/10 §7）============ -->
  <sys:Double x:Key="FontSizeCaption">11</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeRow">14</sys:Double>
  <sys:Double x:Key="FontSizeTitle">18</sys:Double>

  <!-- ============ 圆角（05 §5.3）============ -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
</ResourceDictionary>
