<UserControl x:Class="MailHelper.App.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailHelper.ViewModels;assembly=MailHelper.ViewModels"
             xmlns:app="clr-namespace:MailHelper.App">
    <UserControl.Resources>
        <!-- UserControl 构造期解析 StaticResource：自带转换器实例（不能依赖 Window 资源） -->
        <app:BoolToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
    </UserControl.Resources>
    <!-- 日程页（S18/CHG-015）：Canvas 作业 DDL 分组展示 + 完成/忽略/恢复/打开链接（与 Avalonia 版行为一致） -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 汇总徽章 + 刷新 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="⟳ 刷新" Padding="10,4" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🗓 日程" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                <Border CornerRadius="10" Background="{StaticResource BrushPrimaryTint}" Padding="9,2"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OpenCount, StringFormat={}{0} 项待完成}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- 分组列表（已逾期/今天/未来 7 天/更远/已完成·已忽略；空组不渲染） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Groups}"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScheduleGroupViewModel}">
                            <StackPanel Margin="0,6,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="8" Background="#F3F2F1" Padding="7,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeaderBadge}" FontSize="10" Foreground="#6B6B6B" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScheduleItemRowViewModel}">
                                            <Border Background="{StaticResource BrushSurfaceAlt}"
                                                    CornerRadius="8" Padding="12,9" Margin="0,3"
                                                    BorderBrush="#E1DFDD" BorderThickness="0,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                                       FontWeight="SemiBold" Margin="0,0,7,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="520" VerticalAlignment="Center"
                                                                       ToolTip="{Binding Title}" />
                                                            <Border CornerRadius="8" Background="#F3F2F1"
                                                                    Padding="7,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CourseDisplay}" FontSize="10"
                                                                           Foreground="#4A4A4A" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding DueText}" FontSize="12"
                                                                       Foreground="#6B6B6B"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding RelativeText}" FontSize="12"
                                                                       FontWeight="SemiBold" Margin="10,0,0,0"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#6B6B6B" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                                <Setter Property="Foreground" Value="#D13438" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="#8A8886" Margin="10,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolVis}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="Canvas ↗" FontSize="11" Padding="8,2"
                                                                Margin="0,0,6,0" Click="OnOpenLink" Tag="{Binding Link}"
                                                                Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="完成" FontSize="11" Padding="8,2"
                                                                Margin="0,0,6,0"
                                                                Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="忽略" FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="恢复" FontSize="11" Padding="8,2"
                                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 空态（05 §6） -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasItems, Converter={StaticResource InverseBoolVis}}">
                    <TextBlock Text="🗓" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无日程——Canvas 作业 DDL 会在每轮同步后自动出现在这里"
                               Foreground="#6B6B6B" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding LastSyncText}" FontSize="11" Foreground="#8A8886"
                   Margin="0,8,0,0" />
    </Grid>
</UserControl>
