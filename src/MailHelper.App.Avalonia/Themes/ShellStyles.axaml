<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 暖纸、松绿与精细边界；轻量原生控件保留键盘/无障碍状态。 -->
  <Style Selector="TextBlock.windowTitle">
    <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="8" /><Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" /><Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="38" /><Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="12,8" /><Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="11.5" /><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="Path.navIcon">
    <Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" />
    <Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="Stroke" Value="{DynamicResource BrushTextSecondary}" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sideNav">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,9" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.sideNav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushRowHover}" />
  </Style>
  <Style Selector="Button.sideNav.checked">
    <Setter Property="Background" Value="{DynamicResource BrushSurface}" /><Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.sideNav.checked Path.navIcon">
    <Setter Property="Stroke" Value="{DynamicResource BrushPrimary}" />
  </Style>
  <Style Selector="Button.navItem">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="CornerRadius" Value="7" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
  </Style>
  <Style Selector="Button.navItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushRowHover}" />
  </Style>
  <Style Selector="Button.navItem.checked">
    <Setter Property="Background" Value="{DynamicResource BrushPrimaryTint}" /><Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.compactAction">
    <Setter Property="FontSize" Value="10.5" /><Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.primaryAction">
    <Setter Property="Background" Value="{DynamicResource BrushPrimary}" /><Setter Property="Foreground" Value="{DynamicResource BrushOnPrimary}" />
    <Setter Property="Padding" Value="17,8" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primaryAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushPrimaryHover}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BrushSurface}" /><Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox#CategoryNav ListBoxItem">
    <Setter Property="Padding" Value="10,3" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Margin" Value="0,1" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="MinHeight" Value="31" />
  </Style>
  <Style Selector="ListBox#CategoryNav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushRowHover}" />
  </Style>
  <Style Selector="ListBox#CategoryNav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushPrimaryTint}" />
  </Style>
  <Style Selector="ListBox#MailList ListBoxItem">
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,1" /><Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox#MailList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushRowHover}" />
  </Style>
  <Style Selector="ListBox#MailList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushRowSelected}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="TextBlock.placeholderText">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}" /><Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBlock.statusText">
    <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.readerText">
    <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="25" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>
  <Style Selector="Button.readerLink">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" /><Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
</Styles>
