<Window x:Class="MailHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MailHelper.App"
        xmlns:vm="clr-namespace:MailHelper.App.ViewModels"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MailHelper" Height="760" Width="1280" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <app:ImportanceToBrushConverter x:Key="ImportanceBrush" />
        <app:BoolToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <app:CountToBadgeConverter x:Key="CountBadge" />
        <app:CountToEmptyVisibilityConverter x:Key="CountToEmptyVis" />
        <app:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <app:CountToUnreadNameConverter x:Key="UnreadName" />

        <!-- 邮件行（05 §3.2 中栏）：左缘 3px 色条 + 未读点 + 主题/摘要 + 徽章 + 时间 -->
        <DataTemplate x:Key="MailItemTemplate" DataType="{x:Type vm:MailItemViewModel}">
            <Grid Margin="0,0,0,1" Background="{DynamicResource RowBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Importance, Converter={StaticResource ImportanceBrush}}" />
                <StackPanel Grid.Column="1" Margin="10,6" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock Text="{Binding UnreadGlyph}" Foreground="#0078D4" FontWeight="Bold"
                                   FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FromDisplay}" Foreground="#4A4A4A" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ReceivedText}" DockPanel.Dock="Right" Foreground="#8A8886"
                                   FontSize="12" Margin="8,0,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subject}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#201F1E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="0,2,0,0">
                        <Border DockPanel.Dock="Left" Background="{Binding Importance, Converter={StaticResource ImportanceBrush}}"
                                CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ImportanceText}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="📎" FontSize="11" DockPanel.Dock="Left" Margin="0,0,6,0"
                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Preview}" Foreground="#6B6B6B" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding SyncNowCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- ============ Onboarding（05 §3.1：隐私勾选 + 主按钮） ============ -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420"
                    Visibility="{Binding IsOnboarding, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="📮" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="MailHelper 邮箱管家" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="让港校邮箱里的大事小事，各归其位" Foreground="#6B6B6B" HorizontalAlignment="Center" Margin="0,4,0,24" />
            <Button Content="连接学校邮箱" FontSize="16" Padding="16,10" HorizontalAlignment="Center"
                    Command="{Binding ConnectCommand}" />
            <CheckBox IsChecked="{Binding PrivacyAccepted}" Margin="0,20,0,0">
                <TextBlock Text="同意《隐私说明》：邮件数据仅保存在本机，分类完全在本地完成，不上传任何服务器"
                           TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{Binding SyncStatusText}" Foreground="#D13438" Margin="0,16,0,0"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ 三栏主界面（05 §3.2） ============ -->
        <Grid Visibility="{Binding IsOnboarding, Converter={StaticResource InvBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏：搜索 + 状态徽章 -->
            <DockPanel Grid.Row="0" Background="#F3F2F1" Margin="0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="360" Margin="12,8,4,8" VerticalContentAlignment="Center"
                         AutomationProperties.Name="搜索框">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="搜索" Command="{Binding SearchCommand}" Margin="4,8,4,8" Padding="12,4" />
                <Button Content="清除" Command="{Binding ClearSearchCommand}" Margin="0,8,12,8" Padding="12,4"
                        Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}" />
                <CheckBox Content="仅未读" IsChecked="{Binding UnreadOnly}" Margin="12,0,12,0"
                          Command="{Binding ToggleUnreadOnlyCommand}" VerticalAlignment="Center" />
                <TextBlock Text="Ctrl+F 搜索 · Ctrl+R 立即同步" Foreground="#8A8886" FontSize="11"
                           DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>

            <!-- 三栏 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="220" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="MiddleColumn" Width="3*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="2*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：类别导航 -->
                <ListBox Grid.Column="0" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         BorderThickness="0" Background="#FAF9F8"
                         AutomationProperties.Name="类别导航"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,4" Width="196">
                                <Border DockPanel.Dock="Right" CornerRadius="8" Background="#E1DFDD" Padding="6,1"
                                        VerticalAlignment="Center" MinWidth="24">
                                    <TextBlock Text="{Binding Count, Converter={StaticResource CountBadge}}"
                                               FontSize="11" HorizontalAlignment="Center" Foreground="#4A4A4A"
                                               AutomationProperties.AutomationId="unread-badge"
                                               AutomationProperties.Name="{Binding Count, Converter={StaticResource UnreadName}}" />
                                </Border>
                                <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Icon}" />
                                    <Run Text="{Binding Label}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E1DFDD" />

                <!-- 中栏：邮件列表（虚拟化 + 四态） -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" Height="3" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Mails}" SelectedItem="{Binding SelectedMail, Mode=TwoWay}"
                             ItemTemplate="{StaticResource MailItemTemplate}"
                             BorderThickness="0,0,0,1" BorderBrush="#E1DFDD"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="邮件列表" />
                    <!-- 空态（05 §6）：无邮件时引导 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Mails.Count, Converter={StaticResource CountToEmptyVis}}">
                        <TextBlock Text="🗂" FontSize="40" HorizontalAlignment="Center" />
                        <TextBlock Text="该分类暂无邮件" Foreground="#6B6B6B" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#E1DFDD" />

                <!-- 右栏：阅读窗格（WebView2 沙箱，禁脚本） -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="14,10,14,6" DataContext="{Binding SelectedMail}"
                                Visibility="{Binding SelectedMail, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Subject}" />
                        <DockPanel Margin="0,6,0,0">
                            <Border DockPanel.Dock="Left" CornerRadius="3" Padding="6,1"
                                    Background="{Binding Importance, Converter={StaticResource ImportanceBrush}}">
                                <TextBlock Text="{Binding ImportanceText}" FontSize="11" Foreground="White" />
                            </Border>
                            <TextBlock Foreground="#6B6B6B" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding FromDisplay, Mode=OneWay}" />
                        </DockPanel>
                    </StackPanel>
                    <wv:WebView2 x:Name="Reader" Grid.Row="1" DefaultBackgroundColor="White" />
                    <!-- RISK-04 降级：WebView2 初始化失败时以提示替代白屏（完整纯文本模式随 S9 设置页） -->
                    <TextBlock x:Name="ReaderFallback" Grid.Row="1" Visibility="Collapsed"
                               Margin="14,12" TextWrapping="Wrap" Foreground="#8A8886" />
                    <Border Grid.Row="2" Background="#FAF9F8" Padding="10,6">
                        <TextBlock Text="分类不对？「改为…」入口随 S8 反馈闭环开放；外链在本窗格内不可跳转（安全设置）"
                                   FontSize="11" Foreground="#8A8886" />
                    </Border>
                </Grid>
            </Grid>

            <!-- 状态栏（05 §3.2 底部：同步状态/离线态） -->
            <Border Grid.Row="2" Background="#F3F2F1" Padding="12,5">
                <DockPanel>
                    <Button Content="⟳ 立即同步" DockPanel.Dock="Right" Command="{Binding SyncNowCommand}" Padding="12,3" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#0078D4" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SyncStatusText}" VerticalAlignment="Center" FontSize="12" Foreground="#4A4A4A" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
