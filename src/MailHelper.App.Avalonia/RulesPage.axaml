<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailHelper.ViewModels;assembly=MailHelper.ViewModels"
             xmlns:app="clr-namespace:MailHelper.App.Avalonia" x:Class="MailHelper.App.Avalonia.RulesPage">
  <UserControl.Resources><app:InverseBoolConverter x:Key="InverseBool" /></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.ruleMeta"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" /></Style>
    <Style Selector="ListBox#RulesList ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="18,15" />
      <Setter Property="Margin" Value="0,0,0,9" /><Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource BrushSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" /><Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox#RulesList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushRowSelected}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" /></Style>
    <Style Selector="ListBox#RulesList ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushRowHover}" /></Style>
  </UserControl.Styles>
  <Grid Margin="28,24" MaxWidth="1120" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Margin="0,0,0,22" Spacing="6">
      <TextBlock Text="让分类更懂你" FontSize="11" Foreground="{DynamicResource BrushPrimary}" />
      <TextBlock Text="分类规则" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock Text="管理匹配方式与分类偏好。新规则可以先试跑，再用于后续邮件。" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primaryAction" Content="新建规则" Padding="18,9" Click="OnNewRule" />
        <Button Classes="navItem" Content="试跑选中规则" Padding="14,9" Command="{Binding PreviewCommand}" ToolTip.Tip="在最近 100 封邮件中预览命中结果" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Classes="ruleMeta" Text="规则来源" VerticalAlignment="Center" />
        <ComboBox x:Name="RuleFilter" Width="118" MinHeight="36" SelectedIndex="0" SelectionChanged="OnFilterChanged">
          <ComboBoxItem Content="全部规则" Tag="All" /><ComboBoxItem Content="内置" Tag="Builtin" />
          <ComboBoxItem Content="自定义" Tag="User" /><ComboBoxItem Content="反馈生成" Tag="Feedback" />
        </ComboBox>
      </StackPanel>
    </Grid>
    <ListBox Grid.Row="2" x:Name="RulesList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             Background="Transparent" BorderThickness="0" Padding="0,0,4,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:RuleRowViewModel}">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
              <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" OnContent="启用" OffContent="暂停" FontSize="12" VerticalAlignment="Center" />
              <Button Classes="navItem" Content="编辑" Padding="10,5" Click="OnEditRule" IsVisible="{Binding IsBuiltin, Converter={StaticResource InverseBool}}" />
              <Button Classes="navItem" Content="删除" Padding="10,5" Click="OnDeleteRule" IsVisible="{Binding IsBuiltin, Converter={StaticResource InverseBool}}" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,7" Margin="0,11,0,10">
            <TextBlock Text="{Binding PatternText}" FontSize="12" FontFamily="Cascadia Code, Consolas, Menlo, monospace" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
          </Border>
          <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Classes="ruleMeta" Text="{Binding KindText}" /><TextBlock Classes="ruleMeta" Text="  →  " />
            <TextBlock Classes="ruleMeta" Text="{Binding CategoryText}" /><TextBlock Classes="ruleMeta" Text="{Binding Weight, StringFormat=' · 权重 {0}'}" Margin="12,0,0,0" />
            <TextBlock Classes="ruleMeta" Text="{Binding SourceTag}" Margin="14,0,0,0" />
          </WrapPanel>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="6" IsVisible="{Binding HasPreview}">
      <Border Background="{DynamicResource BrushPrimaryTint}" CornerRadius="8" Padding="14,10">
        <TextBlock Text="{Binding PreviewSummary}" FontSize="13" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" />
      </Border>
      <ScrollViewer MaxHeight="130"><ItemsControl ItemsSource="{Binding PreviewLines}"><ItemsControl.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="12,5" />
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </StackPanel>
  </Grid>
</UserControl>
