<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      S13-C 设计令牌（prompts/S13 §B）：全部控件样式只引用此字典，不留魔法数。
      色板基线 = Fluent（05 章 §5.1 语义色保留），层级化背景 + 主色 #0F6CBD。
    -->

    <!-- ============ 色板 ============ -->
    <Color x:Key="ColorPrimary">#0F6CBD</Color>
    <Color x:Key="ColorPrimaryDeep">#0C5AA0</Color>
    <Color x:Key="ColorPrimaryTint">#EFF6FC</Color>
    <Color x:Key="ColorAccentWarning">#F7630C</Color>
    <Color x:Key="ColorAccentDanger">#D13438</Color>

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryDeep}" />
    <SolidColorBrush x:Key="BrushPrimaryTint" Color="{StaticResource ColorPrimaryTint}" />
    <SolidColorBrush x:Key="BrushWindowBg" Color="#F5F7FA" />
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#FAFBFC" />
    <SolidColorBrush x:Key="BrushTopBar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushDivider" Color="#E5E9EF" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#1B1F26" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#5A6270" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="#8C93A0" />
    <SolidColorBrush x:Key="BrushRowHover" Color="#F0F5FB" />
    <SolidColorBrush x:Key="BrushRowSelected" Color="#E1EEFA" />
    <SolidColorBrush x:Key="BrushUnreadDot" Color="#0F6CBD" />
    <SolidColorBrush x:Key="BrushBadgeBg" Color="#E9EDF3" />
    <SolidColorBrush x:Key="BrushDanger" Color="#D13438" />

    <!-- 类别色（左栏图标底/头像fallback；07 类别语义色） -->
    <SolidColorBrush x:Key="BrushCatCourse" Color="#3A7BD5" />
    <SolidColorBrush x:Key="BrushCatCareer" Color="#0E9F6E" />
    <SolidColorBrush x:Key="BrushCatAdmin" Color="#7C5CDB" />
    <SolidColorBrush x:Key="BrushCatFinance" Color="#D97706" />
    <SolidColorBrush x:Key="BrushCatAnnounce" Color="#0E7490" />
    <SolidColorBrush x:Key="BrushCatSubscription" Color="#8C93A0" />
    <SolidColorBrush x:Key="BrushCatOther" Color="#64748B" />

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="FontApp">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontAppDisplay">Segoe UI Variable Display, Segoe UI Semibold, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeRow">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ============ 基础文本 ============ -->
    <Style x:Key="AppText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource AppText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="AppButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 圆角输入框 ============ -->
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,0,6,0"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#C7D2E3" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="White" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 现代复选框 ============ -->
    <Style x:Key="ModernCheck" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                Background="White" BorderBrush="#C7D2E3" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M3,8 L7,11.5 L13,4.5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 顶栏导航胶囊 ============ -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Text" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushPrimaryTint}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 列表容器（去默认蓝框，圆角行） ============ -->
    <Style x:Key="MailListItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6,0,6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource RadiusMedium}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CategoryListItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontApp}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource RadiusMedium}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushRowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushPrimaryTint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 计数徽章 ============ -->
    <Style x:Key="CategoryBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Background" Value="{StaticResource BrushBadgeBg}" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="22" />
    </Style>
</ResourceDictionary>
